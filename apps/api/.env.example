APP_ENV=development
APP_NAME=ClaimShield AI
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=480
DATABASE_URL=sqlite:///./claimshield.db
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true
CORS_ORIGINS=http://localhost:3000
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=15728640
MIN_IMAGE_WIDTH=640
MIN_IMAGE_HEIGHT=480
ANALYSIS_ADAPTER=fixture
ANALYSIS_PIPELINE_VERSION=damage-pipeline-1.0.0
ANALYSIS_THRESHOLD_VERSION=damage-thresholds-1.0.0
ANALYSIS_TIMEOUT_SECONDS=180
ANALYSIS_MAX_WORKING_SIZE=1600
ANALYSIS_MASK_THRESHOLD=0.55
ANALYSIS_MIN_MASK_RATIO=0.0005
ANALYSIS_MIN_PART_OVERLAP=0.25
ANALYSIS_TIE_MARGIN=0.05
CLIPSEG_MODEL_ID=CIDAS/clipseg-rd64-refined
CLIPSEG_REVISION=999e0328d9e10b484360c477313983f9afdd7050
MODEL_CACHE_PATH=./model-cache
ML_LOCAL_FILES_ONLY=false
